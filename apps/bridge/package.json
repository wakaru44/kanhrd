{
  "name": "@kanhrd/bridge",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "bin": {
    "kanhrd-bridge": "dist/main.js"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@kanhrd/schema": "workspace:*",
    "@fastify/static": "^8.0.4",
    "@fastify/websocket": "^11.0.2",
    "fastify": "^5.1.0",
    "pino": "^9.5.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.5",
    "ws": "^8.18.0"
  }
}
